# ─── SUPABASE ───────────────────────────────────────────────────────────────
# Obtenelos en: supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── ANTHROPIC (Valeria IA) ─────────────────────────────────────────────────
# Obtenelo en: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── OPENAI (transcripción de notas de voz de WhatsApp con Whisper) ────────
# Obtenelo en: platform.openai.com → API Keys
# Sin esta variable, Valeria simplemente le pide al usuario que escriba en vez de
# mandar audio — no rompe nada, solo no transcribe.
OPENAI_API_KEY=sk-...

# ─── RESEND (correos transaccionales) ───────────────────────────────────────
# Obtenelo en: resend.com → API Keys
# Si no esta configurado, los correos de notificacion no se envian
RESEND_API_KEY=re_...

# ─── WHATSAPP BUSINESS (Meta) ───────────────────────────────────────────────
# Obtenelos en: developers.facebook.com → tu app → WhatsApp → API Setup
WHATSAPP_TOKEN=EAA...
WHATSAPP_PHONE_ID=1156099824249418
WHATSAPP_VERIFY_TOKEN=nido-webhook-2026
# App Secret para verificar que los webhooks vienen de Meta (HMAC-SHA256)
# Obtenelo en: developers.facebook.com → tu app → Configuracion basica → App Secret
WHATSAPP_APP_SECRET=abc123...

# ─── MAPBOX (mapas y geocoding) ─────────────────────────────────────────────
# Obtenelo en: account.mapbox.com → Tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# ─── GENERAL ────────────────────────────────────────────────────────────────
# URL publica del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.nido-cr.com

# Secreto para el cron job de noticias
CRON_SECRET=nido-cron-2026-secret
